# Local edge function secrets template — see docs/ENVIRONMENT.md.
#
# Copy to supabase/.env and fill in real values (supabase/.env is gitignored, this file is safe
# to commit since it holds no real secrets):
#   cp supabase/.env.example supabase/.env
#
# The Supabase CLI auto-loads supabase/.env for the local edge-runtime container when running
# `supabase start` / `supabase functions serve`. Restart the stack after changing it — env vars
# load at container start, not hot-reload:
#   npm run dev:down && npm run dev:up

# Required for ai-briefing, race-predictor, generate-plan, parse-plan.
ANTHROPIC_API_KEY=

# Required for strava-auth, strava-sync. Get these from your Strava API app settings
# (https://www.strava.com/settings/api) — use a separate local/dev Strava app if you don't want
# local testing hitting the same OAuth app as production.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Optional — omit to allow only localhost dev origins (see _shared/cors.ts).
# ALLOWED_ORIGIN=
