# Frontend environment variables (Vite build-time — see docs/ENVIRONMENT.md for the full list,
# including Supabase edge function secrets, which never belong in this file).
#
# Copy this file to .env.local and fill in real values:
#   cp .env.example .env.local
#
# Every VITE_-prefixed var here is inlined into the client bundle at build time and is visible to
# anyone who opens dev tools — never put a secret (API key, client secret) behind a VITE_ prefix.

# Supabase project URL and anon (publishable) key. Required — the app throws at startup if either
# is missing (src/lib/supabase.ts). For local development against your own Supabase project, or a
# local `supabase start` stack, NOT the shared production project — see docs/ENVIRONMENT.md.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Strava OAuth app client ID + redirect URI. Optional at startup (the app still boots without
# these), but the "Connect Strava" button builds a broken OAuth URL if unset.
VITE_STRAVA_CLIENT_ID=
VITE_STRAVA_REDIRECT_URI=http://localhost:5173/strava/callback

# Optional. Sentry DSN for frontend error tracking (src/lib/sentry.ts). Leave unset to disable —
# error tracking becomes a no-op rather than failing, so this is safe to omit entirely.
VITE_SENTRY_DSN=
